# XiaoP ShopBot v3. Generate independent random secrets; never commit .env.
NODE_ENV=production
BOT_TOKEN=
ADMIN_TELEGRAM_ID=
SUPPORT_USERNAME=@xiaop3040
ADMIN_API_KEY=
# SePay incoming webhook: select API Key authentication in SePay dashboard.
SEPAY_WEBHOOK_KEY=
# Optional separate outgoing SePay REST API token for reconciliation.
SEPAY_API_KEY=
# 64 hexadecimal characters, e.g. openssl rand -hex 32. Keep an offline copy.
DATA_ENCRYPTION_KEY=
# 32-256 characters using A-Z, a-z, 0-9, _ and -.
TELEGRAM_WEBHOOK_SECRET=
BANK_ID=
BANK_CODE=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
PORT=3000
WEBHOOK_PATH=/webhook/sepay
DB_PATH=/data/bot.db
BACKUP_DIR=/data/backups
ORDER_EXPIRY_MINUTES=5
# Railway enables Telegram webhook mode. Otherwise Telegram uses long polling.
# RAILWAY_PUBLIC_DOMAIN=your-domain.example
# Optional checker: no paid scraping, exact host allowlist, no redirects.
ENABLE_LINK_CHECKER=false
CHECKER_ALLOWED_HOSTS=
