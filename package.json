{
  "name": "xiaop-shopbot",
  "version": "3.0.0",
  "description": "Telegram auto-sales bot with VietQR payment and SePay webhook verification",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "NODE_ENV=development node --watch src/bot.js",
    "seed": "node src/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "node-telegram-bot-api": "^2.1.0",
    "sql.js": "^1.15.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
